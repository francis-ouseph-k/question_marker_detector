# Copy to .env and adjust. Values here override config/default.yaml.
# Nested keys use a double underscore: QMD_<SECTION>__<KEY>

# Which YAML configuration file to load
QMD_CONFIG_FILE=config/default.yaml

# Logging
QMD_APP__LOG_LEVEL=INFO
QMD_APP__LOG_FORMAT=text
QMD_APP__OUTPUT_ROOT=./output

# OCR backend: paddle (PP-OCRv5 Mobile, default) or onnx
QMD_OCR__BACKEND=paddle
# Offline / pinned PaddleOCR model folders (optional)
# QMD_OCR__DET_MODEL_DIR=/opt/qmd/models/PP-OCRv5_mobile_det
# QMD_OCR__REC_MODEL_DIR=/opt/qmd/models/PP-OCRv5_mobile_rec
# ONNX model files (optional; empty = models bundled with rapidocr)
# QMD_OCR__ONNX_REC_MODEL_PATH=/opt/qmd/models/ppocrv5_mobile_rec.onnx
# QMD_OCR__ONNX_REC_KEYS_PATH=/opt/qmd/models/ppocrv5_dict.txt

# Parallelism: workers x threads_per_worker ~= physical CPU cores
QMD_PROCESSING__WORKERS=1
QMD_OCR__THREADS_PER_WORKER=2

# PaddleOCR: skip the slow model-host connectivity check when using local models
# DISABLE_MODEL_SOURCE_CHECK=True
